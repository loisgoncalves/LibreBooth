<Project>

  <!--
    Numéro de version de LibreBooth : un seul, pour le programme, sa bibliothèque et le programme d'installation.
    Il s'affiche dans l'admin › Système, et c'est lui que les mises à jour comparent à la dernière version publiée.

    Version majeure.mineure.correctif (par exemple 2.1.3) :
      - majeure    (2.0.0 → 3.0.0) : changement important qui modifie les habitudes ou les fichiers de l'utilisateur
                                     (ex. 2.0.0 : nouveaux dossiers d'événements, convertis au premier lancement) ;
      - fonction   (2.0.0 → 2.1.0) : nouvelle fonction ou changement visible, sans rien casser ;
      - correctif  (2.1.0 → 2.1.1) : correction d'un problème, sans nouveauté.

    Pour changer de version, utiliser le script (il met aussi une entrée dans CHANGELOG.md) :
      .\installer\nouvelle-version.ps1 -Type correctif|fonction|majeure
  -->
  <PropertyGroup>
    <Version>3.2.0</Version>
  </PropertyGroup>

</Project>
