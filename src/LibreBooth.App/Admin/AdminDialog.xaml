<Window x:Class="LibreBooth.App.Admin.AdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibreBooth"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        MinWidth="440" MaxWidth="680"
        WindowStartupLocation="CenterOwner">
    <!-- Confirmation ou message de l'admin, aux couleurs de l'apparence choisie (remplace la petite boîte de Windows) -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Admin.Window}" TextElement.Foreground="{DynamicResource Admin.Text}"
          TextElement.FontSize="16" TextElement.FontFamily="Segoe UI">
        <Grid.Resources>
            <ResourceDictionary Source="/LibreBooth;component/Resources/AdminStyles.xaml" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,26,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" FontFamily="{DynamicResource IconFont}" FontSize="30" Margin="0,0,18,0" VerticalAlignment="Top"
                       Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxWidth="500" VerticalAlignment="Center" LineHeight="24" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Admin.Sidebar}" BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,1,0,0"
                Padding="20,14,12,14">
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
