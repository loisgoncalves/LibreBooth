<Window x:Class="LibreBooth.App.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:admin="clr-namespace:LibreBooth.App.Admin"
        xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure"
        xmlns:ready="clr-namespace:LibreBooth.Core.Admin;assembly=LibreBooth.Core"
        Title="LibreBooth – Administration"
        Width="1440" Height="920" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid" Background="{DynamicResource Admin.Window}" TextElement.Foreground="{DynamicResource Admin.Text}"
          TextElement.FontSize="16" TextElement.FontFamily="Segoe UI">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/LibreBooth;component/Resources/AdminStyles.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- Contenu d'une page : à gauche, de la même largeur sur toutes les pages, sans s'étirer à l'infini sur les grands écrans -->
                <Style x:Key="PageContent" TargetType="infra:PagePanel">
                    <Setter Property="Margin" Value="32,24,32,32" />
                    <Setter Property="MaxWidth" Value="1100" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </Style>

                <!-- Un point de la liste « Prêt pour l'événement ? » -->
                <DataTemplate x:Key="ReadinessRowTemplate">
                    <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Admin.Divider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="22" Width="28"
                                       Margin="0,1,14,0" VerticalAlignment="Top" Foreground="{DynamicResource Admin.Success}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ligne Papier, compteur à 0 ou rouleau signalé vide : remettre le compteur à zéro sans changer de page -->
                                <Button Margin="16,0,0,0" Click="NewRoll_Click" infra:AdminUi.Glyph="&#xE73E;"
                                        Content="{Binding NewRollLabel}" AutomationProperties.Name="{Binding NewRollLabel}"
                                        Visibility="{Binding NewRollLabel, Converter={StaticResource NullToCollapsed}}" />
                                <Button Style="{StaticResource SubtleButton}" Margin="16,0,0,0"
                                        Tag="{Binding}" Click="ReadinessAction_Click" AutomationProperties.Name="{Binding ActionName}"
                                        Visibility="{Binding PageName, Converter={StaticResource NullToCollapsed}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PageName}" />
                                        <TextBlock Text="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static ready:ReadinessLevel.Info}">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Admin.Info}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static ready:ReadinessLevel.Warning}">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Admin.Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static ready:ReadinessLevel.Error}">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Admin.Error}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!-- Chiffre de l'événement sur l'accueil (sessions, photos, impressions) -->
                <Style x:Key="StatNumber" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="26" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================ Menu de gauche -->
        <Border x:Name="Sidebar" Grid.RowSpan="2" Background="{DynamicResource Admin.Sidebar}" BorderBrush="{DynamicResource Admin.Divider}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,8">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resources/icone-librebooth.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel x:Name="BrandTexts" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LibreBooth" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="HeaderVersionText" Text="Administration" FontSize="13" Foreground="{DynamicResource Admin.TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="SidebarEventCard" Margin="0,18,0,6" Padding="12,10" CornerRadius="8" Background="{DynamicResource Admin.Card}"
                            BorderBrush="{DynamicResource Admin.CardBorder}" BorderThickness="1" ToolTip="Événement ouvert">
                        <StackPanel>
                            <TextBlock Text="Événement" FontSize="12" Foreground="{DynamicResource Admin.TextMuted}" />
                            <TextBlock x:Name="SidebarEventName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SidebarEventDate" FontSize="13" Foreground="{DynamicResource Admin.TextMuted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged" AutomationProperties.Name="Pages de l'admin" Margin="0,4,0,12">
                    <ListBoxItem Content="Accueil" Tag="{x:Static admin:AdminPage.Home}" infra:AdminUi.Glyph="&#xE80F;" AutomationProperties.Name="Accueil" />
                    <ListBoxItem Content="Événement" Tag="{x:Static admin:AdminPage.Event}" infra:AdminUi.Glyph="&#xE787;" AutomationProperties.Name="Événement" />
                    <ListBoxItem Content="Personnalisation" Tag="{x:Static admin:AdminPage.Customization}" infra:AdminUi.Glyph="&#xE790;" AutomationProperties.Name="Personnalisation" />
                    <ListBoxItem Content="Appareil photo" Tag="{x:Static admin:AdminPage.Camera}" infra:AdminUi.Glyph="&#xE722;" AutomationProperties.Name="Appareil photo" />
                    <ListBoxItem Content="Impression" Tag="{x:Static admin:AdminPage.Print}" infra:AdminUi.Glyph="&#xE749;" AutomationProperties.Name="Impression" />
                    <ListBoxItem Content="Écrans" Tag="{x:Static admin:AdminPage.Screens}" infra:AdminUi.Glyph="&#xE7F4;" AutomationProperties.Name="Écrans" />
                    <ListBoxItem Content="Système" Tag="{x:Static admin:AdminPage.System}" infra:AdminUi.Glyph="&#xE713;" AutomationProperties.Name="Système" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================================================================ Pages -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Nouvelle version trouvée sur GitHub (seulement dans l'admin, jamais au photobooth) -->
            <Border x:Name="UpdateBanner" Style="{StaticResource InfoBar}" Margin="32,16,32,0" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Voir la mise à jour" Click="ShowUpdate_Click" Margin="12,0,0,0" />
                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource Admin.Info}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid x:Name="Pages" Grid.Row="1">

                <!-- ================================================================ Accueil -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                    <infra:PagePanel Style="{StaticResource PageContent}">
                        <TextBlock Text="Accueil" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Préparez l'événement avec le menu à gauche, puis cliquez sur « Démarrer le photobooth »."
                                   Style="{StaticResource PageSubtitle}" />

                        <!-- L'événement ouvert -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Événement ouvert" Style="{StaticResource Help}" Margin="0" />
                                    <TextBlock x:Name="HomeEventName" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HomeEventDate" Foreground="{DynamicResource Admin.TextMuted}" Margin="0,2,0,14" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,36,0">
                                            <TextBlock x:Name="HomeSessionsText" Style="{StaticResource StatNumber}" Text="0" />
                                            <TextBlock x:Name="HomeSessionsLabel" Text="sessions" Style="{StaticResource Help}" Margin="0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,36,0">
                                            <TextBlock x:Name="HomePhotosText" Style="{StaticResource StatNumber}" Text="0" />
                                            <TextBlock x:Name="HomePhotosLabel" Text="photos" Style="{StaticResource Help}" Margin="0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,36,0">
                                            <TextBlock x:Name="HomePrintsText" Style="{StaticResource StatNumber}" Text="0" />
                                            <TextBlock x:Name="HomePrintsLabel" Text="impressions" Style="{StaticResource Help}" Margin="0" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <Button Content="Ouvrir le dossier des photos" infra:AdminUi.Glyph="&#xE838;" HorizontalContentAlignment="Left"
                                            Click="OpenEventFolder_Click" Margin="0,0,0,8" />
                                    <Button Content="Changer d'événement…" infra:AdminUi.Glyph="&#xE8AB;" HorizontalContentAlignment="Left"
                                            Click="ChangeEvent_Click" Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Prêt pour l'événement ? -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ReadinessIcon" Text="&#xE930;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                                               VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource Admin.Success}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Prêt pour l'événement ?" Style="{StaticResource Help}" Margin="0" />
                                        <TextBlock x:Name="ReadinessSummaryText" Text="Vérification…" FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="ReadinessList" ItemTemplate="{StaticResource ReadinessRowTemplate}" Focusable="False"
                                              AutomationProperties.Name="Prêt pour l'événement ?" />
                                <TextBlock Style="{StaticResource Help}" Margin="0,10,0,0"
                                           Text="Cette liste se met à jour toute seule, chaque seconde." />
                            </StackPanel>
                        </Border>

                        <!-- Raccourcis -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Avant d'ouvrir le photobooth" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Button Content="Prendre une photo de test" infra:AdminUi.Glyph="&#xE722;" Click="ShortcutCamera_Click" />
                                    <Button Content="Imprimer un essai" infra:AdminUi.Glyph="&#xE749;" Click="ShortcutPrintTest_Click" />
                                    <Button Content="Réimprimer une photo" infra:AdminUi.Glyph="&#xE8B9;" Click="ShortcutReprint_Click" />
                                    <Button Content="Vérifier l'installation" infra:AdminUi.Glyph="&#xE9D9;" Click="Verify_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InfoBar}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource Admin.Info}"
                                           Margin="0,2,12,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                    <Run Text="Pendant l'événement, pour revenir ici ou quitter :" FontWeight="SemiBold" />
                                    <Run Text="bouton rond en bas à droite de l'accueil du photobooth (ou appui long de 3 secondes en haut à droite, ou Ctrl + Maj + A), puis le code PIN." />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </infra:PagePanel>
                </ScrollViewer>

                <!-- ================================================================ Événement -->
                <ScrollViewer x:Name="EventPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <infra:PagePanel Style="{StaticResource PageContent}">
                        <TextBlock Text="Événement" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="L'événement ouvert, ses photos et la réimpression." Style="{StaticResource PageSubtitle}" />

                        <GroupBox Header="Événement en cours">
                            <StackPanel>
                                <TextBlock x:Name="EventNameText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="EventDateText" Style="{StaticResource Value}" />
                                <TextBlock x:Name="StatsText" Style="{StaticResource Value}" Foreground="{DynamicResource Admin.Success}" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Ouvrir le dossier des photos" infra:AdminUi.Glyph="&#xE838;" Click="OpenEventFolder_Click" />
                                    <Button Content="Changer d'événement…" infra:AdminUi.Glyph="&#xE8AB;" Click="ChangeEvent_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="EventFolderText" Style="{StaticResource Help}" />
                                <TextBlock Text="Renommer l'événement" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBlock Text="Le texte {evenement} des modèles et le nom du dossier changent aussi." Style="{StaticResource Help}" Margin="0,2,0,6" />
                                <WrapPanel>
                                    <TextBox x:Name="RenameNameBox" Width="420" Margin="0,0,8,8" AutomationProperties.Name="Nom de l'événement" />
                                    <DatePicker x:Name="RenameDatePicker" Width="170" Margin="0,0,8,8" AutomationProperties.Name="Date de l'événement" />
                                    <Button Content="Enregistrer" infra:AdminUi.Glyph="&#xE74E;" Click="RenameEvent_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Galerie (dernières sessions)">
                            <StackPanel>
                                <ListBox x:Name="GalleryList" MaxHeight="450" BorderThickness="1" Padding="4" Background="{DynamicResource Admin.Window}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Galerie">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="230" Margin="2">
                                                <Border Height="150" CornerRadius="6" Background="{DynamicResource Admin.Preview}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="13" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Réimprimer la photo choisie" infra:AdminUi.Glyph="&#xE749;" Style="{StaticResource AccentButton}" Click="Reprint_Click" />
                                    <Button Content="Actualiser" infra:AdminUi.Glyph="&#xE72C;" Click="RefreshGallery_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="GalleryStatusText" Style="{StaticResource Help}" />
                            </StackPanel>
                        </GroupBox>
                    </infra:PagePanel>
                </ScrollViewer>

                <!-- ================================================================ Personnalisation -->
                <Grid x:Name="CustomizationPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="32,24,32,0">
                        <TextBlock Text="Personnalisation" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="CustomizationSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,4"
                                   Text="Formats proposés, thème ou vos images, textes et modèles de l'événement ouvert. Tout est enregistré au fur et à mesure." />
                    </StackPanel>
                    <admin:CustomizationPanel x:Name="CustomizationView" Grid.Row="1" />
                </Grid>

                <!-- ================================================================ Appareil photo -->
                <ScrollViewer x:Name="CameraPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <infra:PagePanel Style="{StaticResource PageContent}">
                        <TextBlock Text="Appareil photo" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="L'appareil utilisé, son pilote, un essai et ses réglages." Style="{StaticResource PageSubtitle}" />

                        <GroupBox Header="Appareil utilisé">
                            <StackPanel>
                                <WrapPanel>
                                    <RadioButton x:Name="CanonRadio" Style="{StaticResource ChoiceCard}" GroupName="CameraKind" Checked="CameraKind_Changed"
                                                 Content="Canon EOS" infra:AdminUi.Glyph="&#xE722;" MinWidth="300"
                                                 infra:AdminUi.Description="Reflex ou hybride Canon, branché en USB." />
                                    <RadioButton x:Name="DemoRadio" Style="{StaticResource ChoiceCard}" GroupName="CameraKind" Checked="CameraKind_Changed"
                                                 Content="Appareil de démonstration" infra:AdminUi.Glyph="&#xE8B9;" MinWidth="300"
                                                 infra:AdminUi.Description="Images d'exemple, pour essayer sans appareil." />
                                </WrapPanel>
                                <TextBlock x:Name="CameraModeHelp" Style="{StaticResource Help}" Margin="0,0,0,8" />
                                <TextBlock x:Name="CameraStatusText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="CameraDetailText" Style="{StaticResource Help}" Margin="0,2,0,2" />
                                <TextBlock x:Name="BatteryText" Style="{StaticResource Value}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="CameraDriverGroup" Header="Pilote du Canon">
                            <StackPanel>
                                <WrapPanel>
                                    <RadioButton x:Name="WindowsDriverRadio" Style="{StaticResource ChoiceCard}" GroupName="CameraDriver" Checked="CameraDriver_Changed"
                                                 Content="Pilote de Windows" infra:AdminUi.Glyph="&#xE88E;" MinWidth="300"
                                                 infra:AdminUi.Description="Conseillé : intégré à Windows, rien à installer." />
                                    <RadioButton x:Name="SdkDriverRadio" Style="{StaticResource ChoiceCard}" GroupName="CameraDriver" Checked="CameraDriver_Changed"
                                                 Content="SDK Canon (secours)" infra:AdminUi.Glyph="&#xE943;" MinWidth="300"
                                                 infra:AdminUi.Description="Si Windows ne sait pas piloter votre modèle. À télécharger chez Canon." />
                                </WrapPanel>
                                <TextBlock x:Name="CameraDriverHelp" Style="{StaticResource Help}" Margin="0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="CanonSdkGroup" Header="SDK Canon (pilote de secours)">
                            <StackPanel>
                                <TextBlock x:Name="CanonSdkText" Style="{StaticResource Value}" FontWeight="SemiBold" />
                                <TextBlock x:Name="CanonSdkHelp" Style="{StaticResource Help}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="1. Ouvrir la page Canon" infra:AdminUi.Glyph="&#xE8A7;" Click="OpenCanonPage_Click" />
                                    <Button x:Name="ImportCanonSdkButton" Content="2. Ajouter le SDK Canon…" infra:AdminUi.Glyph="&#xE8B5;" Click="ImportCanonSdk_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Essai">
                            <StackPanel>
                                <WrapPanel>
                                    <Button x:Name="LiveTestButton" Content="Démarrer le live view" infra:AdminUi.Glyph="&#xE768;" Click="LiveTest_Click" />
                                    <Button x:Name="TestPhotoButton" Content="Prendre une photo de test" infra:AdminUi.Glyph="&#xE722;" Style="{StaticResource AccentButton}"
                                            Click="TestPhoto_Click" />
                                </WrapPanel>
                                <Border Background="{DynamicResource Admin.Preview}" Height="380" Margin="0,8,0,0" CornerRadius="8">
                                    <Image x:Name="CameraPreview" Stretch="Uniform" Margin="4" />
                                </Border>
                                <TextBlock x:Name="CameraTestStatus" Style="{StaticResource Help}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Réglages">
                            <StackPanel>
                                <infra:SettingRow Title="Live view en miroir" Description="Conseillé : les invités se voient comme dans un miroir.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Camera.MirrorLiveView}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Photos finales en miroir" Description="Déconseillé : les textes seraient à l'envers.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Camera.MirrorPhotos}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Autofocus avant chaque photo" Description="Déconseillé : la mise au point manuelle est plus fiable.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Camera.UseAutofocus}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Rotation de l'appareil" Description="Sur son support, en degrés.">
                                    <ComboBox x:Name="RotationCombo" Width="140" Margin="0" SelectedItem="{Binding Camera.Rotation}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Délai maximal pour recevoir une photo" Description="En secondes." Margin="0">
                                    <TextBox Width="100" Margin="0" Text="{Binding Camera.CaptureTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Conseils pour le Canon EOS 1300D">
                            <TextBlock Style="{StaticResource Help}" FontSize="15" Margin="0" LineHeight="24">
                                • Molette sur M (manuel) et objectif en MF (mise au point manuelle), faite une fois sur la place des invités.<LineBreak />
                                • Qualité d'image : JPEG « M » (plus rapide à transférer sur l'USB 2.0 du 1300D). Pas de RAW.<LineBreak />
                                • Menu : extinction automatique « Désactivée », Wi-Fi « Désactivé » (sinon l'USB ne fonctionne pas).<LineBreak />
                                • Alimentation secteur DR-E10 + ACK-E10 à la place de la batterie pour les longs événements.<LineBreak />
                                • Fermez EOS Utility et désactivez l'importation automatique de Windows (Photos).
                            </TextBlock>
                        </GroupBox>
                    </infra:PagePanel>
                </ScrollViewer>

                <!-- ================================================================ Impression -->
                <ScrollViewer x:Name="PrintPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <infra:PagePanel Style="{StaticResource PageContent}">
                        <TextBlock Text="Impression" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="L'imprimante, son état, le papier, les réglages du pilote et les copies." Style="{StaticResource PageSubtitle}" />

                        <GroupBox Header="Imprimante">
                            <StackPanel>
                                <infra:SettingRow Title="Impression activée" Description="Désactivée, les invités repartent sans tirage.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Print.Enabled}" />
                                </infra:SettingRow>
                                <TextBlock Text="Imprimante Windows à utiliser" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Installez d'abord le pilote DNP de votre modèle." Style="{StaticResource Help}" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <ComboBox x:Name="PrinterCombo" Width="480" Margin="0,0,8,8" SelectionChanged="PrinterCombo_SelectionChanged"
                                              AutomationProperties.Name="Imprimante Windows à utiliser" />
                                    <Button Content="Actualiser la liste" infra:AdminUi.Glyph="&#xE72C;" Click="RefreshPrinters_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock x:Name="PrinterModeHelp" Style="{StaticResource Help}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="État de l'imprimante et papier">
                            <StackPanel>
                                <TextBlock x:Name="PrinterStateText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="RemainingText" Style="{StaticResource Value}" />
                                <TextBlock x:Name="PrinterDetailsText" Style="{StaticResource Help}" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Actualiser l'état" infra:AdminUi.Glyph="&#xE72C;" Click="RefreshPrinterState_Click" />
                                    <Button Content="J'ai installé un nouveau rouleau" infra:AdminUi.Glyph="&#xE73E;" Click="NewRoll_Click" />
                                </WrapPanel>
                                <infra:SettingRow Title="Lire le compteur et les erreurs de la DNP" Description="Avec cspstat.dll, l'API d'état des imprimantes DNP.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Print.UseDnpStatus}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Alerte « papier bientôt terminé »" Description="À partir de ce nombre de tirages restants.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Print.LowMediaWarning, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Capacité du rouleau" Description="En tirages 10x15, pour le compteur de LibreBooth, utilisé si le compteur de la DNP est indisponible. Rouleau 15x20 de DS620 : 400." Margin="0,0,0,4">
                                    <TextBox Width="100" Margin="0" Text="{Binding Print.MediaCapacity, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <TextBlock x:Name="MediaCounterText" Style="{StaticResource Help}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Réglages du pilote par format">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8">
                                    Avec une DNP, cliquez sur « Réglages automatiques DNP » : LibreBooth prépare le 10x15 (papier 6x4, coupe standard)
                                    et les bandelettes (papier 6x4, coupe 2 pouces). Sinon, ouvrez la fenêtre du pilote pour chaque format.
                                    LibreBooth mémorise ces réglages et les réapplique à chaque impression.
                                </TextBlock>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Réglages automatiques DNP (recommandé)" infra:AdminUi.Glyph="&#xE713;" Style="{StaticResource AccentButton}"
                                            Click="AutoDnp_Click" />
                                </WrapPanel>
                                <ItemsControl x:Name="ProfilesList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Content="Réglages du pilote…" Tag="{Binding}" Click="DriverSettings_Click" />
                                                        <Button Content="Page de test" Tag="{Binding}" Click="TestPage_Click" />
                                                        <Button Content="Réinitialiser" Tag="{Binding}" Click="ResetDriver_Click" Margin="0,4,0,4" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ProfileStatusText" Style="{StaticResource Help}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Copies">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Help}" Margin="0,0,0,12"
                                           Text="Le nombre d'exemplaires que l'invité peut choisir se règle pour chaque événement, dans la page Personnalisation." />
                                <infra:SettingRow Title="Impression automatique" Description="Dès que le montage est prêt, sans attendre l'invité.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Print.AutoPrint}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Nombre d'impressions automatiques" Description="Sans dépasser le maximum de l'événement.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Print.AutoPrintCopies, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Limite d'impressions pour tout l'événement" Description="0 = illimité." Margin="0">
                                    <TextBox Width="100" Margin="0" Text="{Binding Print.EventPrintLimit, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                            </StackPanel>
                        </GroupBox>
                    </infra:PagePanel>
                </ScrollViewer>

                <!-- ================================================================ Écrans -->
                <ScrollViewer x:Name="ScreensPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <infra:PagePanel Style="{StaticResource PageContent}">
                        <TextBlock Text="Écrans du photobooth" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Les textes, l'affichage et le rythme des écrans que voient les invités." Style="{StaticResource PageSubtitle}" />

                        <GroupBox Header="Textes">
                            <StackPanel>
                                <TextBlock Text="Titre de l'écran d'accueil (vide = nom de l'événement)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Screens.Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Titre de l'écran d'accueil" />
                                <TextBlock Text="Invitation sous le titre" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Screens.StartText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Invitation sous le titre" />
                                <TextBlock Text="Titre de l'écran de fin" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Screens.ThanksText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Titre de l'écran de fin" />
                                <TextBlock Text="Message de fin après une impression" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Screens.ThanksPrintText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                         AutomationProperties.Name="Message de fin après une impression" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Affichage">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Help}" Margin="0,0,0,12">
                                    Les couleurs des écrans, la police des titres et l'image de l'écran d'accueil se règlent pour chaque événement,
                                    dans la page Personnalisation : elles s'accordent aux impressions.
                                </TextBlock>
                                <infra:SettingRow Title="Masquer le pointeur de la souris"
                                                  Description="Quand elle ne bouge pas (il réapparaît dès qu'on la bouge). La souris marche comme l'écran tactile : un clic vaut un appui. Pour ouvrir l'admin : bouton gauche maintenu 3 secondes en haut à droite de l'écran, ou Ctrl + Maj + A.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Screens.HideCursor}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Toujours au premier plan" Description="Le photobooth reste devant les autres fenêtres." Margin="0">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Screens.Topmost}" />
                                </infra:SettingRow>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Rythme">
                            <StackPanel>
                                <infra:SettingRow Title="Compte à rebours avant chaque photo" Description="En secondes.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Screens.CountdownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Affichage de chaque photo après la prise" Description="En millisecondes.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Screens.PreviewMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Touche qui lance une session" Description="Bouton d'arcade USB qui imite un clavier.">
                                    <ComboBox x:Name="StartKeyCombo" Width="160" Margin="0" SelectedItem="{Binding Screens.StartKey}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Bouton « Recommencer »"
                                                  Description="Nombre de fois par invité, sur l'écran de la photo (0 = pas de bouton). L'invité refait toute sa série tant qu'il n'a pas imprimé ; les photos refusées sont gardées dans le dossier « Photos refusées » de l'événement. Le bouton n'apparaît pas avec l'impression automatique."
                                                  Margin="0">
                                    <ComboBox x:Name="RetakeCombo" Width="100" Margin="0" SelectedItem="{Binding Screens.RetakeLimit}" />
                                </infra:SettingRow>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Retour automatique à l'accueil">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Help}" Margin="0,0,0,12"
                                           Text="Si personne ne touche l'écran, le photobooth revient à l'accueil après ce délai, en secondes." />
                                <infra:SettingRow Title="Choix du format" Description="Écran où l'invité choisit son format.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Screens.ChooseTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Revue de la photo" Description="Écran où l'invité imprime ou recommence.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Screens.ReviewTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Écran de fin" Description="« Merci ! », dès que l'invité appuie sur « Imprimer » ou « Terminer », puis l'accueil pour l'invité suivant.">
                                    <TextBox Width="100" Margin="0" Text="{Binding Screens.ThanksSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Écran d'erreur" Description="Quand l'appareil ou l'imprimante a un problème." Margin="0">
                                    <TextBox Width="100" Margin="0" Text="{Binding Screens.ErrorSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </infra:SettingRow>
                            </StackPanel>
                        </GroupBox>
                    </infra:PagePanel>
                </ScrollViewer>

                <!-- ================================================================ Système -->
                <ScrollViewer x:Name="SystemPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <infra:PagePanel Style="{StaticResource PageContent}">
                        <TextBlock Text="Système" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Apparence de l'admin, code PIN, démarrage, mises à jour, et à propos de LibreBooth." Style="{StaticResource PageSubtitle}" />

                        <GroupBox Header="Apparence de l'admin">
                            <StackPanel>
                                <WrapPanel>
                                    <RadioButton x:Name="AppearanceLightRadio" Style="{StaticResource ChoiceCard}" GroupName="AdminAppearance" Checked="Appearance_Checked"
                                                 Content="Clair" infra:AdminUi.Glyph="&#xE706;" infra:AdminUi.Description="Fond clair, conseillé de jour." />
                                    <RadioButton x:Name="AppearanceDarkRadio" Style="{StaticResource ChoiceCard}" GroupName="AdminAppearance" Checked="Appearance_Checked"
                                                 Content="Sombre" infra:AdminUi.Glyph="&#xE708;" infra:AdminUi.Description="Fond sombre, plus discret le soir." />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Help}" Margin="0"
                                           Text="Seulement pour l'admin et ses fenêtres : le photobooth garde les couleurs de l'événement." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Code PIN de l'admin">
                            <StackPanel>
                                <TextBlock Text="Nouveau code (4 à 8 chiffres)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="NewPinBox" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Nouveau code" />
                                <TextBlock Text="Confirmation" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ConfirmPinBox" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Confirmation du code" />
                                <WrapPanel>
                                    <Button Content="Changer le code" infra:AdminUi.Glyph="&#xE72E;" Click="ChangePin_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="PinStatusText" Style="{StaticResource Help}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Démarrage">
                            <infra:SettingRow Title="Lancer LibreBooth au démarrage de Windows" Description="Le code PIN est demandé à chaque lancement." Margin="0">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtStartup}" />
                            </infra:SettingRow>
                        </GroupBox>

                        <GroupBox x:Name="UpdatesGroup" Header="Mises à jour">
                            <StackPanel>
                                <infra:SettingRow Title="Rechercher les nouvelles versions au lancement" Description="Quand le PC est connecté à Internet.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}" />
                                </infra:SettingRow>
                                <infra:SettingRow Title="Proposer aussi les pré-versions"
                                                  Description="Versions d'essai, pas encore validées sur un booth : elles peuvent contenir des erreurs. Pour vos essais, jamais juste avant un événement.">
                                    <CheckBox x:Name="PrereleasesSwitch" Style="{StaticResource Switch}" Checked="Prereleases_Changed" Unchecked="Prereleases_Changed"
                                              AutomationProperties.Name="Proposer aussi les pré-versions" />
                                </infra:SettingRow>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Value}" FontWeight="SemiBold" />
                                <!-- Pré-version trouvée : mise en garde avant de l'installer -->
                                <Border x:Name="PrereleaseWarning" Style="{StaticResource WarningBar}" Visibility="Collapsed" Margin="0,4,0,8">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource Admin.Warning}"
                                                   VerticalAlignment="Top" Margin="0,1,12,0" />
                                        <TextBlock x:Name="PrereleaseWarningText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Help}" Visibility="Collapsed" Margin="16,2,0,8" />
                                <ProgressBar x:Name="UpdateProgress" Width="460" HorizontalAlignment="Left" Minimum="0" Maximum="1"
                                             Visibility="Collapsed" Margin="0,6,0,8" />
                                <WrapPanel>
                                    <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" infra:AdminUi.Glyph="&#xE896;" Click="InstallUpdate_Click"
                                            Visibility="Collapsed" />
                                    <Button x:Name="CheckUpdatesButton" Content="Rechercher maintenant" infra:AdminUi.Glyph="&#xE72C;" Click="CheckUpdates_Click" />
                                    <Button x:Name="UpdatePageButton" Content="Voir les nouveautés sur GitHub" infra:AdminUi.Glyph="&#xE8A7;" Click="UpdatePage_Click"
                                            Visibility="Collapsed" />
                                </WrapPanel>
                                <!-- Pré-version installée : retour à la dernière version stable -->
                                <Border x:Name="ReturnToStablePanel" Style="{StaticResource WarningBar}" Visibility="Collapsed" Margin="0,10,0,8">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource Admin.Warning}"
                                                   VerticalAlignment="Top" Margin="0,1,12,0" />
                                        <StackPanel>
                                            <TextBlock x:Name="ReturnToStableText" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button x:Name="ReturnToStableButton" infra:AdminUi.Glyph="&#xE7A7;" Click="ReturnToStable_Click" Margin="0" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Help}"
                                           Text="Une mise à jour s'installe seulement d'ici, jamais pendant le photobooth. LibreBooth télécharge la nouvelle version depuis GitHub, contrôle son empreinte (SHA-256), puis se ferme : Windows demande l'autorisation, et la nouvelle version remplace l'ancienne. Photos, événements, réglages et pilotes sont gardés." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="À propos de LibreBooth">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,4,24,4" VerticalAlignment="Top">
                                    <Image Source="pack://application:,,,/Resources/logo-librebooth.png" Width="200" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="VersionText" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,4" />
                                    <TextBlock Style="{StaticResource Value}">
                                        <Run Text="Conçu et réalisé par" /> <Run Text="Loïs Gonçalves" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Value}" Text="Logiciel de photobooth gratuit, sans licence ni abonnement. © 2026 Loïs Gonçalves." />
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="Avec les bibliothèques libres .NET et WPF, SkiaSharp, CommunityToolkit.Mvvm et Serilog. Le SDK Canon (EDSDK, facultatif) et l'API d'état DNP (cspstat.dll) appartiennent à leurs fabricants." />
                                    <TextBlock x:Name="ModeText" Style="{StaticResource Value}" />
                                    <TextBlock x:Name="DataFolderText" Style="{StaticResource Value}" />
                                    <WrapPanel>
                                        <Button Content="Ouvrir le dossier des données" infra:AdminUi.Glyph="&#xE838;" Click="OpenDataFolder_Click" />
                                        <Button Content="Vérifier l'installation" infra:AdminUi.Glyph="&#xE9D9;" Click="Verify_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <Expander x:Name="LogExpander" Header="Journal (dépannage)" infra:AdminUi.Glyph="&#xE8A5;" Expanded="LogExpander_Expanded">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="LogText" Height="380" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Journal" />
                                <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                                    <Button Content="Actualiser" infra:AdminUi.Glyph="&#xE72C;" Click="RefreshLog_Click" />
                                    <Button Content="Ouvrir le dossier des journaux" infra:AdminUi.Glyph="&#xE838;" Click="OpenLogFolder_Click" />
                                </WrapPanel>
                            </Grid>
                        </Expander>
                    </infra:PagePanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================================ Bas de l'admin -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Admin.Card}" BorderBrush="{DynamicResource Admin.Divider}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="StartBoothButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Démarrer le photobooth"
                        infra:AdminUi.Glyph="&#xE768;" FontSize="18" Padding="26,10" Margin="0" Click="Close_Click"
                        ToolTip="Ferme l'administration et lance l'écran d'accueil pour les invités" />
                <Button x:Name="QuitAppButton" DockPanel.Dock="Right" Style="{StaticResource DangerSubtleButton}" Content="Quitter LibreBooth"
                        infra:AdminUi.Glyph="&#xE7E8;" Padding="18,10" Margin="0,0,12,0" Click="Quit_Click"
                        ToolTip="Ferme complètement LibreBooth (l'appareil photo et l'imprimante sont libérés)" />
                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="CameraChip" Style="{StaticResource ChipButton}" Click="CameraChip_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CameraChipDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CameraChipText" Text="Appareil" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrinterChip" Style="{StaticResource ChipButton}" Click="PrinterChip_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PrinterChipDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PrinterChipText" Text="Imprimante" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PaperChip" Style="{StaticResource ChipButton}" Click="PrinterChip_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PaperChipDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PaperChipText" Text="Papier" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
