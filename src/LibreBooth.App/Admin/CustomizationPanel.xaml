<UserControl x:Class="LibreBooth.App.Admin.CustomizationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:LibreBooth.App.Admin"
             xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure"
             TextElement.FontSize="16" TextElement.FontFamily="Segoe UI">
    <!--
        Les styles de l'admin (AdminStyles.xaml) sont portés par la fenêtre d'admin : ce panneau est créé avant d'y être posé,
        il les lit donc en DynamicResource. Les styles ci-dessous lui sont propres.
    -->
    <UserControl.Resources>
        <!-- Libellé dans une ligne (« Taille », « par photo ») -->
        <Style x:Key="InlineLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <!-- Sous-partie d'une section repliable (Polices, Couleurs, Décor et photos) -->
        <Style x:Key="SubSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <!-- Vignette d'une image (fond, logo, accueil) -->
        <Style x:Key="ThumbFrame" TargetType="Border">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="84" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Admin.Window}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- Pastille de couleur : un clic ouvre le choix de la couleur -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Choisir la couleur" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AdminFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Admin.ControlBorder}"
                                BorderThickness="1" CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Thème au choix : vignette, nom et catégorie ; le thème actuel est entouré et coché -->
        <Style x:Key="ThemeTile" TargetType="Button">
            <!-- Sans cela, le texte prend la couleur des boutons de Windows (noir), illisible en sombre -->
            <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AdminFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{DynamicResource Admin.Card}" BorderBrush="{DynamicResource Admin.CardBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="6">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Ring" BorderBrush="{DynamicResource Admin.AccentText}" BorderThickness="2" CornerRadius="8" Visibility="Hidden" />
                            <Border x:Name="Mark" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Admin.Accent}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Visibility="Hidden">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource Admin.OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.AccentSoft}" />
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="620" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ Réglages -->
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,16,32">
                <!-- Le mode de personnalisation : un thème de LibreBooth, ou vos propres images -->
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <RadioButton x:Name="ThemeModeRadio" GroupName="DesignMode" Style="{DynamicResource ChoiceCard}" Margin="0,0,6,8" MinWidth="0"
                                 Checked="Mode_Checked" Content="Thème LibreBooth" infra:AdminUi.Glyph="&#xE790;"
                                 infra:AdminUi.Description="Un thème prêt à l'emploi (couleurs, polices, décor), à retoucher si besoin." />
                    <RadioButton x:Name="OwnModeRadio" GroupName="DesignMode" Style="{DynamicResource ChoiceCard}" Margin="6,0,0,8" MinWidth="0"
                                 Checked="Mode_Checked" Content="Mes propres images" infra:AdminUi.Glyph="&#xEB9F;"
                                 infra:AdminUi.Description="Vos fonds faits dans Canva ou Photoshop, votre logo et votre image d'accueil." />
                </UniformGrid>

                <GroupBox x:Name="ThemeGroup" Header="Thème">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Help}" Margin="0,0,0,12">
                            Un thème règle d'un coup les couleurs, les polices, le décor et le style des photos.
                            Vous pouvez ensuite tout retoucher dans « Couleurs, polices et décor ». Vos textes, votre logo et votre image d'accueil sont conservés.
                        </TextBlock>
                        <ItemsControl x:Name="ThemesList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Theme_Click" Tag="{Binding}" Style="{StaticResource ThemeTile}" ToolTip="{Binding Description}"
                                            AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}">
                                        <StackPanel Width="156">
                                            <Border Height="104" CornerRadius="5" Background="{DynamicResource Admin.Window}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource Admin.TextMuted}" FontSize="13" Margin="2,0,0,2" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="ImagesGroup" Header="Mes images">
                    <StackPanel>
                        <StackPanel x:Name="OwnBackgroundsPanel">
                            <TextBlock Style="{DynamicResource Help}" Margin="0,0,0,8">
                                1. Exportez le gabarit du format. 2. Dessinez votre fond dans Canva ou Photoshop à la même taille.
                                3. Importez-le : les photos des invités sont posées par-dessus. Un format sans image garde le thème.
                            </TextBlock>
                            <ItemsControl x:Name="BackgroundsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource ThumbFrame}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding State}" FontSize="14" Foreground="{DynamicResource Admin.TextMuted}" TextWrapping="Wrap" />
                                                    <WrapPanel>
                                                        <Button Content="Exporter le gabarit…" infra:AdminUi.Glyph="&#xE896;" Tag="{Binding}" Click="ExportGuide_Click" />
                                                        <Button Content="Choisir mon fond…" infra:AdminUi.Glyph="&#xE8B5;" Tag="{Binding}" Click="ChooseBackground_Click" />
                                                        <Button Content="Retirer" Tag="{Binding}" Click="RemoveBackground_Click" IsEnabled="{Binding HasBackground}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox x:Name="TextsOverBackgroundCheck" Content="Écrire aussi les textes de LibreBooth sur mes fonds" Margin="0,10,0,6"
                                      Checked="Changed" Unchecked="Changed" />
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ThumbFrame}">
                                    <Image x:Name="LogoThumb" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Logo" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LogoStateText" FontSize="14" Foreground="{DynamicResource Admin.TextMuted}" TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <Button Content="Choisir un logo…" infra:AdminUi.Glyph="&#xE8B5;" Click="ChooseLogo_Click" />
                                        <Button x:Name="RemoveLogoButton" Content="Retirer" Click="RemoveLogo_Click" />
                                    </WrapPanel>
                                    <TextBlock Style="{DynamicResource Help}" Margin="0">
                                        PNG à fond transparent conseillé. À droite des textes sur le 10x15, en bas du marque-page.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Padding="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ThumbFrame}" ClipToBounds="True">
                                    <Image x:Name="AttractThumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Image de l'écran d'accueil du photobooth" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="AttractStateText" FontSize="14" Foreground="{DynamicResource Admin.TextMuted}" TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <Button Content="Choisir une image…" infra:AdminUi.Glyph="&#xE8B5;" Click="ChooseAttract_Click" />
                                        <Button x:Name="RemoveAttractButton" Content="Retirer" Click="RemoveAttract_Click" />
                                        <Button Content="Voir l'écran d'accueil" Style="{DynamicResource SubtleButton}" Click="ShowAttractPreview_Click" />
                                    </WrapPanel>
                                    <TextBlock Style="{DynamicResource Help}" Margin="0">
                                        Format écran 16:9 (1920 × 1080 px conseillé). Le titre et l'invitation s'écrivent par-dessus, en blanc.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="KioskColorsText" Style="{DynamicResource Help}" Margin="0,12,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Textes">
                    <StackPanel>
                        <TextBlock Text="Titre" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="TitleBox" TextChanged="Changed" AutomationProperties.Name="Titre" />
                        <TextBlock Text="Sous-titre (la date en général)" Style="{DynamicResource FieldLabel}" />
                        <TextBox x:Name="SubtitleBox" TextChanged="Changed" AutomationProperties.Name="Sous-titre" />
                        <TextBlock Text="Phrase (facultative : remerciement, hashtag…)" Style="{DynamicResource FieldLabel}" />
                        <TextBox x:Name="PhraseBox" TextChanged="Changed" AutomationProperties.Name="Phrase" />
                        <TextBlock Style="{DynamicResource Help}" Margin="0,2,0,0">
                            {evenement} = nom de l'événement · {date} = 22.11.2026 · {date_longue} = 22 novembre 2026.
                            Laissez une case vide pour ne rien écrire. Le texte rétrécit tout seul s'il est trop long.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Formats proposés aux invités">
                    <StackPanel>
                        <ItemsControl x:Name="FormatsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,5" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Admin.TextMuted}" FontSize="14" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="Exemplaires : l'invité choisit de 1 à" Style="{StaticResource InlineLabel}" />
                            <ComboBox x:Name="MaxCopiesCombo" Width="80" Margin="0,0,10,0" SelectionChanged="Changed"
                                      AutomationProperties.Name="Nombre d'exemplaires au plus, par photo" />
                            <TextBlock Text="par photo" Style="{StaticResource InlineLabel}" />
                        </WrapPanel>
                        <TextBlock Style="{DynamicResource Help}" Margin="0,8,0,0">
                            Marque-page : un exemplaire = une feuille 10x15 coupée par la DNP en deux marque-pages identiques.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <Expander x:Name="AdvancedExpander" Header="Couleurs, polices et décor" infra:AdminUi.Glyph="&#xE771;" IsExpanded="True">
                    <StackPanel>
                        <TextBlock Text="Polices" Style="{StaticResource SubSection}" />
                        <TextBlock Text="Titre" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                        <WrapPanel>
                            <ComboBox x:Name="TitleFontCombo" Width="250" Margin="0,0,8,8" SelectionChanged="Changed" MaxDropDownHeight="420"
                                      AutomationProperties.Name="Police du titre">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="18" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="TitleWeightCombo" Width="140" Margin="0,0,16,8" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="Changed" AutomationProperties.Name="Graisse du titre" />
                            <CheckBox x:Name="TitleItalicCheck" Content="Italique" Margin="0,0,16,8" Checked="Changed" Unchecked="Changed" />
                            <CheckBox x:Name="TitleUpperCheck" Content="MAJUSCULES espacées" Margin="0,0,0,8" Checked="Changed" Unchecked="Changed" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Taille" Style="{StaticResource InlineLabel}" Width="60" />
                            <Slider x:Name="TitleScaleSlider" Width="260" Minimum="50" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderChanged" AutomationProperties.Name="Taille du titre" />
                            <TextBlock x:Name="TitleScaleText" Style="{StaticResource InlineLabel}" Margin="12,0,0,0" />
                        </WrapPanel>

                        <TextBlock Text="Date et phrase" Style="{DynamicResource FieldLabel}" Margin="0,16,0,4" />
                        <WrapPanel>
                            <ComboBox x:Name="TextFontCombo" Width="250" Margin="0,0,8,8" SelectionChanged="Changed" MaxDropDownHeight="420"
                                      AutomationProperties.Name="Police de la date et de la phrase">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="18" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="TextWeightCombo" Width="140" Margin="0,0,16,8" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="Changed" AutomationProperties.Name="Graisse de la date et de la phrase" />
                            <CheckBox x:Name="TextItalicCheck" Content="Italique" Margin="0,0,16,8" Checked="Changed" Unchecked="Changed" />
                            <CheckBox x:Name="TextUpperCheck" Content="MAJUSCULES espacées" Margin="0,0,0,8" Checked="Changed" Unchecked="Changed" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Taille" Style="{StaticResource InlineLabel}" Width="60" />
                            <Slider x:Name="TextScaleSlider" Width="260" Minimum="50" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderChanged" AutomationProperties.Name="Taille de la date et de la phrase" />
                            <TextBlock x:Name="TextScaleText" Style="{StaticResource InlineLabel}" Margin="12,0,0,0" />
                        </WrapPanel>
                        <TextBlock x:Name="FontWarningText" Style="{DynamicResource Help}" Foreground="{DynamicResource Admin.Error}" />

                        <Border Style="{DynamicResource Divider}" Margin="0,8,0,16" />
                        <TextBlock Text="Couleurs" Style="{StaticResource SubSection}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Fond" Style="{StaticResource InlineLabel}" Margin="0,0,10,8" />
                            <Button x:Name="BackgroundSwatch" Grid.Column="1" Style="{StaticResource Swatch}" Tag="{Binding ElementName=BackgroundColorBox}"
                                    Click="Swatch_Click" AutomationProperties.Name="Choisir la couleur du fond" />
                            <TextBox x:Name="BackgroundColorBox" Grid.Column="2" Margin="0,0,0,8" TextChanged="Changed" AutomationProperties.Name="Couleur du fond" />

                            <TextBlock Grid.Row="1" Text="Titre" Style="{StaticResource InlineLabel}" Margin="0,0,10,8" />
                            <Button x:Name="TitleSwatch" Grid.Row="1" Grid.Column="1" Style="{StaticResource Swatch}" Tag="{Binding ElementName=TitleColorBox}"
                                    Click="Swatch_Click" AutomationProperties.Name="Choisir la couleur du titre" />
                            <TextBox x:Name="TitleColorBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" TextChanged="Changed" AutomationProperties.Name="Couleur du titre" />

                            <TextBlock Grid.Row="2" Text="Date et phrase" Style="{StaticResource InlineLabel}" Margin="0,0,10,8" />
                            <Button x:Name="TextSwatch" Grid.Row="2" Grid.Column="1" Style="{StaticResource Swatch}" Tag="{Binding ElementName=TextColorBox}"
                                    Click="Swatch_Click" AutomationProperties.Name="Choisir la couleur de la date et de la phrase" />
                            <TextBox x:Name="TextColorBox" Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" TextChanged="Changed"
                                     AutomationProperties.Name="Couleur de la date et de la phrase" />

                            <TextBlock Grid.Row="3" Text="Décor (1re couleur)" Style="{StaticResource InlineLabel}" Margin="0,0,10,8" />
                            <Button x:Name="AccentSwatch" Grid.Row="3" Grid.Column="1" Style="{StaticResource Swatch}" Tag="{Binding ElementName=AccentColorBox}"
                                    Click="Swatch_Click" AutomationProperties.Name="Choisir la première couleur du décor" />
                            <TextBox x:Name="AccentColorBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,8" TextChanged="Changed"
                                     AutomationProperties.Name="Première couleur du décor" />

                            <TextBlock Grid.Row="4" Text="Décor (2e couleur)" Style="{StaticResource InlineLabel}" Margin="0,0,10,8" />
                            <Button x:Name="Accent2Swatch" Grid.Row="4" Grid.Column="1" Style="{StaticResource Swatch}" Tag="{Binding ElementName=Accent2ColorBox}"
                                    Click="Swatch_Click" AutomationProperties.Name="Choisir la deuxième couleur du décor" />
                            <TextBox x:Name="Accent2ColorBox" Grid.Row="4" Grid.Column="2" Margin="0,0,0,8" TextChanged="Changed"
                                     AutomationProperties.Name="Deuxième couleur du décor" />
                        </Grid>

                        <Border Style="{DynamicResource Divider}" Margin="0,8,0,16" />
                        <TextBlock Text="Décor et photos" Style="{StaticResource SubSection}" />
                        <WrapPanel>
                            <TextBlock Text="Décor" Style="{StaticResource InlineLabel}" Width="210" />
                            <ComboBox x:Name="DecorCombo" Width="240" Margin="0,0,0,8" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Changed"
                                      AutomationProperties.Name="Décor" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Coins arrondis des photos" Style="{StaticResource InlineLabel}" Width="210" />
                            <Slider x:Name="CornerSlider" Width="220" Minimum="0" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderChanged" AutomationProperties.Name="Coins arrondis des photos" />
                            <TextBlock x:Name="CornerText" Style="{StaticResource InlineLabel}" Margin="12,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Bordure autour des photos" Style="{StaticResource InlineLabel}" Width="210" />
                            <Slider x:Name="BorderSlider" Width="220" Minimum="0" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderChanged" AutomationProperties.Name="Bordure autour des photos" />
                            <TextBlock x:Name="BorderText" Style="{StaticResource InlineLabel}" Margin="12,0,0,0" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Couleur de la bordure" Style="{StaticResource InlineLabel}" Width="210" Margin="0,0,10,8" />
                            <Button x:Name="BorderSwatch" Style="{StaticResource Swatch}" Tag="{Binding ElementName=BorderColorBox}" Click="Swatch_Click"
                                    AutomationProperties.Name="Choisir la couleur de la bordure" />
                            <TextBox x:Name="BorderColorBox" Width="120" Margin="0,0,0,8" TextChanged="Changed" AutomationProperties.Name="Couleur de la bordure" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox x:Name="ShadowCheck" Content="Ombre sous les photos" Margin="0,4,24,0" Checked="Changed" Unchecked="Changed" />
                            <CheckBox x:Name="BlackWhiteCheck" Content="Photos en noir et blanc" Margin="0,4,0,0" Checked="Changed" Unchecked="Changed" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <GroupBox Header="Reprendre la personnalisation d'un autre événement">
                    <StackPanel>
                        <WrapPanel>
                            <ComboBox x:Name="CopyEventCombo" Width="380" Margin="0,0,8,8" AutomationProperties.Name="Événement à reprendre" />
                            <Button Content="Copier ici" infra:AdminUi.Glyph="&#xE8C8;" Click="CopyFromEvent_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{DynamicResource Help}" Margin="0"
                                   Text="Formats, exemplaires, thème, textes, fond, logo et image d'accueil sont repris tels quels." />
                    </StackPanel>
                </GroupBox>

                <!-- Les modèles (anciennement l'onglet « Modèles ») : chargés à l'ouverture de la section -->
                <Expander x:Name="TemplatesExpander" Header="Modèles et cadres PNG" infra:AdminUi.Glyph="&#xE81E;" Margin="0"
                          Expanded="TemplatesExpander_Expanded">
                    <admin:TemplatesPanel x:Name="TemplatesView" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ Aperçu -->
        <Grid Grid.Column="1" Margin="8,8,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel>
                <TextBlock Text="Aperçu :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ItemsControl x:Name="PreviewFormatsList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}" GroupName="PreviewFormat" IsChecked="{Binding IsSelected}" Checked="PreviewFormat_Checked"
                                         Tag="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <Border Grid.Row="1" Background="{DynamicResource Admin.Preview}" CornerRadius="10" Padding="18" Margin="0,8">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Texte clair : le fond de l'aperçu reste sombre en clair comme en sombre -->
                    <TextBlock x:Name="PreviewBusyText" Text="Aperçu en cours…" Foreground="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="PreviewNoteText" Style="{DynamicResource Help}" />
                <WrapPanel>
                    <Button x:Name="PrintTestButton" Content="Imprimer un essai de ce format…" infra:AdminUi.Glyph="&#xE749;" Click="PrintTest_Click" />
                </WrapPanel>
                <TextBlock x:Name="StatusText" Style="{DynamicResource Help}" Foreground="{DynamicResource Admin.Success}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
