<Window x:Class="LibreBooth.App.Admin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code administrateur"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1E2028"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PinKey" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2E323D" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC83D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="36" BorderBrush="#FFC83D" BorderThickness="2">
        <StackPanel Width="400">
            <!-- Au lancement de LibreBooth : le logo au-dessus du code -->
            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18" Visibility="Collapsed">
                <Image Source="pack://application:,,,/Resources/icone-librebooth.png" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="LibreBooth" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="TitleText" Text="Code administrateur" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="HintText" FontSize="16" Foreground="#B8BCC8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="DotsText" FontSize="46" HorizontalAlignment="Center" Margin="0,18,0,0" MinHeight="64" />
            <TextBlock x:Name="ErrorText" Foreground="#FF7A7A" FontSize="18" HorizontalAlignment="Center" MinHeight="26" />
            <UniformGrid x:Name="Keypad" Columns="3" Margin="0,10,0,0" />
            <Button Style="{StaticResource PinKey}" Content="Annuler" FontSize="24" Height="64" Margin="6,16,6,0" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
