<Window x:Class="LibreBooth.App.Admin.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure"
        Title="LibreBooth – Éditeur de modèle"
        Width="1440" Height="920"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False">

    <!-- Aux couleurs de l'admin, en clair ou en sombre. Styles sur la grille (et pas sur la fenêtre) : les captures les gardent. -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Admin.Window}" TextElement.Foreground="{DynamicResource Admin.Text}"
          TextElement.FontSize="15" TextElement.FontFamily="Segoe UI">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/LibreBooth;component/Resources/AdminStyles.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <ControlTemplate x:Key="MoveThumbTemplate" TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
                <!-- Poignée orange pour redimensionner une zone (sur le plan de travail, toujours sombre) -->
                <ControlTemplate x:Key="ResizeThumbTemplate" TargetType="Thumb">
                    <Border Background="#FFFF9800" CornerRadius="4" BorderBrush="White" BorderThickness="2" />
                </ControlTemplate>
                <!-- Liste comme un champ : bordure et fond des contrôles -->
                <Style x:Key="FieldList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Setter Property="Background" Value="{DynamicResource Admin.Control}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="0,2,0,6" />
                </Style>
                <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                    <Setter Property="Margin" Value="0,6,0,3" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!-- Plan de travail : le cadre et les zones photo (déplaçables et redimensionnables) -->
        <Border Background="{DynamicResource Admin.Preview}" Margin="16" CornerRadius="10" Padding="16">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="CanvasHost">
                    <Rectangle x:Name="BackgroundRect" />
                    <Image x:Name="FrameImage" Stretch="Fill" />
                    <Canvas x:Name="ZonesCanvas" Background="Transparent" />
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- Toujours visibles en bas : aperçu, enregistrer, annuler -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Admin.Card}" BorderBrush="{DynamicResource Admin.Divider}"
                    BorderThickness="1,1,0,0" Padding="16,10">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Help}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Content="Enregistrer" infra:AdminUi.Glyph="&#xE74E;" Style="{StaticResource AccentButton}" Click="Save_Click" />
                        <Button Content="Aperçu" infra:AdminUi.Glyph="&#xE890;" Click="Preview_Click" />
                        <Button Content="Annuler" Click="Cancel_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,16,8">
                    <Border x:Name="InfoPanel" Style="{StaticResource InfoBar}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource Admin.Info}"
                                       Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="InfoText" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <GroupBox Header="Modèle">
                        <StackPanel>
                            <TextBlock Text="Nom du modèle" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <TextBox x:Name="NameBox" AutomationProperties.Name="Nom du modèle" />
                            <TextBlock x:Name="SizeText" Style="{StaticResource Help}" />
                            <CheckBox x:Name="StripCheck" Content="Bandelette 5x15 : placée deux fois sur le 10x15" Margin="0,4,0,4" Click="Options_Changed" />
                            <CheckBox x:Name="BwCheck" Content="Photos en noir et blanc" Margin="0,4,0,4" />
                            <TextBlock Text="Profil d'impression (réglages du pilote)" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ProfileCombo" IsEditable="True" AutomationProperties.Name="Profil d'impression" />
                            <StackPanel x:Name="FrameOptions">
                                <TextBlock Text="Couleur de fond sous les photos (#RRVVBB)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="BackgroundColorBox" Width="140" HorizontalAlignment="Left" LostFocus="BackgroundColor_LostFocus"
                                         AutomationProperties.Name="Couleur de fond sous les photos" />
                                <Button Content="Changer le cadre PNG…" infra:AdminUi.Glyph="&#xE8B5;" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Click="ChangeFrame_Click" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Zones photo">
                        <StackPanel>
                            <TextBlock Text="L'ordre des zones est l'ordre des prises de vue. Glissez une zone pour la déplacer, sa poignée orange pour la redimensionner."
                                       Style="{StaticResource Help}" Margin="0,0,0,6" />
                            <ListBox x:Name="ZonesList" Style="{StaticResource FieldList}" Height="130" SelectionChanged="ZonesList_SelectionChanged"
                                     AutomationProperties.Name="Zones photo" />
                            <WrapPanel>
                                <Button x:Name="DetectZonesButton" Content="Détecter les zones transparentes" infra:AdminUi.Glyph="&#xE721;" Click="DetectZones_Click" />
                                <Button Content="Ajouter" infra:AdminUi.Glyph="&#xE710;" Click="AddZone_Click" />
                                <Button Content="Supprimer" infra:AdminUi.Glyph="&#xE74D;" Click="RemoveZone_Click" />
                                <Button Content="Ranger dans l'ordre de lecture" infra:AdminUi.Glyph="&#xE8CB;" Click="SortZones_Click" />
                            </WrapPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="X" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="ZoneXBox" AutomationProperties.Name="Zone : X" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Y" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="ZoneYBox" AutomationProperties.Name="Zone : Y" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="Largeur" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="ZoneWBox" AutomationProperties.Name="Zone : largeur" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Hauteur" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="ZoneHBox" AutomationProperties.Name="Zone : hauteur" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Appliquer à la zone" infra:AdminUi.Glyph="&#xE73E;" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ApplyZone_Click" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="TextsSection" Header="Textes ({evenement} et {date} sont remplacés)">
                        <StackPanel>
                            <ListBox x:Name="TextsList" Style="{StaticResource FieldList}" Height="90" SelectionChanged="TextsList_SelectionChanged"
                                     AutomationProperties.Name="Textes" />
                            <WrapPanel>
                                <Button Content="Ajouter un texte" infra:AdminUi.Glyph="&#xE710;" Click="AddText_Click" />
                                <Button Content="Supprimer" infra:AdminUi.Glyph="&#xE74D;" Click="RemoveText_Click" />
                            </WrapPanel>
                            <TextBlock Text="Contenu" Style="{StaticResource SmallLabel}" />
                            <TextBox x:Name="TextContentBox" AutomationProperties.Name="Contenu du texte" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="X" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="TextXBox" AutomationProperties.Name="Texte : X" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Y (ligne de base)" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="TextYBox" AutomationProperties.Name="Texte : Y" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Taille" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="TextSizeBox" AutomationProperties.Name="Texte : taille" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Couleur" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="TextColorBox" AutomationProperties.Name="Texte : couleur" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Police" Style="{StaticResource SmallLabel}" />
                                    <TextBox x:Name="TextFontBox" AutomationProperties.Name="Texte : police" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alignement" Style="{StaticResource SmallLabel}" />
                                    <ComboBox x:Name="TextAlignCombo" AutomationProperties.Name="Texte : alignement" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox x:Name="TextBoldCheck" Content="Gras" Margin="0,4,16,4" />
                                <CheckBox x:Name="TextItalicCheck" Content="Italique" Margin="0,4,16,4" />
                            </WrapPanel>
                            <Button Content="Appliquer au texte" infra:AdminUi.Glyph="&#xE73E;" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ApplyText_Click" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
