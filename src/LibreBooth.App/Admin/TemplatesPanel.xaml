<UserControl x:Class="LibreBooth.App.Admin.TemplatesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure">
    <!-- Styles de l'admin en DynamicResource : ce panneau est créé avant d'être posé dans la fenêtre qui les porte. -->
    <StackPanel>
        <TextBlock Style="{DynamicResource Help}" Margin="0,0,0,12">
            Les deux modèles de LibreBooth suivent les réglages de cette page. Vous pouvez aussi importer un cadre PNG
            fait dans Canva ou Photoshop, avec des zones transparentes pour les photos (1800 × 1200 px pour un 10x15,
            600 × 1800 px pour une bandelette 5x15) : il garde alors son propre décor. Cochez-le ensuite dans
            « Formats proposés aux invités ».
        </TextBlock>
        <ListBox x:Name="TemplatesList" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Modèles">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2" AutomationProperties.Name="{Binding Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="104" CornerRadius="6" Background="{DynamicResource Admin.Preview}" Margin="0,0,14,0">
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Details}" FontSize="14" Foreground="{DynamicResource Admin.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,10,0,0">
            <Button Content="Importer un cadre PNG…" infra:AdminUi.Glyph="&#xE8B5;" Style="{DynamicResource AccentButton}" Click="ImportTemplate_Click" />
            <Button Content="Modifier…" infra:AdminUi.Glyph="&#xE70F;" Click="EditTemplate_Click" />
            <Button Content="Dupliquer" infra:AdminUi.Glyph="&#xE8C8;" Click="DuplicateTemplate_Click" />
            <Button Content="Supprimer" infra:AdminUi.Glyph="&#xE74D;" Click="DeleteTemplate_Click" />
            <Button Content="Ouvrir le dossier des modèles" infra:AdminUi.Glyph="&#xE838;" Click="OpenTemplatesFolder_Click" />
        </WrapPanel>
    </StackPanel>
</UserControl>
