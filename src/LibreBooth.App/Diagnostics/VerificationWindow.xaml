<Window x:Class="LibreBooth.App.Diagnostics.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diag="clr-namespace:LibreBooth.App.Diagnostics"
        Title="LibreBooth – Vérification de l'installation"
        Width="900" Height="760" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI" FontSize="15">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#F4F8F5" BorderBrush="#D5E6DA" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <Image Source="pack://application:,,,/Resources/icone-librebooth.png" Height="52" DockPanel.Dock="Left" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Vérification de LibreBooth" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Dossiers, fichiers, pilotes, imprimante DNP et appareil photo. Rien n'est modifié ni imprimé."
                               Foreground="#555" TextWrapping="Wrap" />
                    <ProgressBar x:Name="BusyBar" Height="4" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,6,18,12">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#1D4D2E" Margin="0,14,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,7" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Badge" Width="26" Height="26" CornerRadius="13" Background="#1E7B34" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                                    <TextBlock x:Name="Glyph" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#444" TextWrapping="Wrap" />
                                    <TextBlock Foreground="#8A4B00" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding Fix, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="À faire : " FontWeight="SemiBold" /><Run Text="{Binding Fix, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static diag:CheckStatus.Info}">
                                <Setter TargetName="Badge" Property="Background" Value="#1E6FC8" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static diag:CheckStatus.Warning}">
                                <Setter TargetName="Badge" Property="Background" Value="#C77700" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static diag:CheckStatus.Error}">
                                <Setter TargetName="Badge" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="RerunButton" Content="Relancer la vérification" Padding="14,6" Margin="0,0,8,0" Click="Rerun_Click" />
                    <Button Content="Enregistrer le rapport…" Padding="14,6" Margin="0,0,8,0" Click="SaveReport_Click" />
                    <Button x:Name="LaunchButton" Content="Lancer LibreBooth" Padding="14,6" Margin="0,0,8,0" FontWeight="SemiBold" Click="Launch_Click" />
                    <Button Content="Fermer" Padding="18,6" IsCancel="True" Click="Close_Click" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
