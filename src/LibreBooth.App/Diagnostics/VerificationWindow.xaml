<Window x:Class="LibreBooth.App.Diagnostics.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diag="clr-namespace:LibreBooth.App.Diagnostics"
        xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure"
        Title="LibreBooth – Vérification de l'installation"
        Width="900" Height="760" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <!-- Aux couleurs de l'admin, en clair ou en sombre. Styles sur la grille (et pas sur la fenêtre) : les captures les gardent. -->
    <Grid Background="{DynamicResource Admin.Window}" TextElement.Foreground="{DynamicResource Admin.Text}"
          TextElement.FontSize="15" TextElement.FontFamily="Segoe UI">
        <Grid.Resources>
            <ResourceDictionary Source="/LibreBooth;component/Resources/AdminStyles.xaml" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Admin.Sidebar}" BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Image Source="pack://application:,,,/Resources/icone-librebooth.png" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Vérification de LibreBooth" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Dossiers, fichiers, pilotes, imprimante DNP et appareil photo. Rien n'est modifié ni imprimé."
                               Style="{StaticResource Help}" Margin="0,2,0,0" />
                    <ProgressBar x:Name="BusyBar" Height="4" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- SDK Canon manquant : il ne peut pas être livré avec LibreBooth, on aide à l'ajouter. -->
        <Border x:Name="CanonSdkBanner" Grid.Row="1" Style="{StaticResource WarningBar}" CornerRadius="0" Padding="20,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="20" Foreground="{DynamicResource Admin.Warning}"
                           Margin="0,1,12,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Il manque le SDK Canon (pilote de l'appareil photo)" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,6"
                               Text="Il appartient à Canon et ne peut pas être fourni avec LibreBooth. 1. Ouvrez la page Canon, inscrivez-vous (gratuit) et téléchargez le SDK « EDSDK » pour Windows. 2. Indiquez le fichier zip téléchargé : LibreBooth en extrait lui-même les bons fichiers." />
                    <WrapPanel>
                        <Button Content="1. Ouvrir la page Canon" infra:AdminUi.Glyph="&#xE8A7;" Click="OpenCanonPage_Click" />
                        <Button x:Name="CanonSdkImportButton" Content="2. Ajouter le SDK Canon…" infra:AdminUi.Glyph="&#xE8B5;" Style="{StaticResource AccentButton}"
                                Click="ImportCanonSdk_Click" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,4,20,14">
            <ItemsControl x:Name="ResultsList" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,8" BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Text="&#xE930;" FontFamily="{DynamicResource IconFont}" FontSize="22"
                                           Foreground="{DynamicResource Admin.Success}" VerticalAlignment="Top" Margin="0,0,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Admin.TextMuted}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource Admin.Warning}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding Fix, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="À faire : " FontWeight="SemiBold" /><Run Text="{Binding Fix, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static diag:CheckStatus.Info}">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Admin.Info}" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static diag:CheckStatus.Warning}">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Admin.Warning}" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static diag:CheckStatus.Error}">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Admin.Error}" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE783;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource Admin.Card}" BorderBrush="{DynamicResource Admin.Divider}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="RerunButton" Content="Relancer" infra:AdminUi.Glyph="&#xE72C;" Click="Rerun_Click"
                            ToolTip="Relancer la vérification" />
                    <Button Content="Enregistrer le rapport…" infra:AdminUi.Glyph="&#xE74E;" Click="SaveReport_Click" />
                    <Button x:Name="LaunchButton" Content="Lancer LibreBooth" infra:AdminUi.Glyph="&#xE768;" Style="{StaticResource AccentButton}"
                            Click="Launch_Click" />
                    <Button Content="Fermer" IsCancel="True" Margin="0,4,0,4" Click="Close_Click" />
                </WrapPanel>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
