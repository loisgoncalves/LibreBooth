<!--
    Styles des fenêtres de l'admin (version 3.0.0), en clair comme en sombre.
    Les couleurs sont les ressources « Admin.* » écrites par Infrastructure/AdminTheme.cs (Core/Design/AdminPalette.cs),
    lues en DynamicResource : changer d'apparence met tout à jour sans rouvrir les fenêtres.
    Ce dictionnaire est fusionné sur l'élément racine de chaque fenêtre de l'admin (et non dans App.xaml), pour que ses
    styles implicites ne touchent pas le photobooth, et pour que les captures (CaptureRunner) les gardent.
    Rien de propre à Windows 11 : texte en Segoe UI, icônes par la ressource IconFont (Segoe Fluent Icons, ou Segoe MDL2
    Assets sous Windows 10).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- ================================================================ Focus au clavier -->
    <Style x:Key="AdminFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Admin.Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Textes -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,20" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.TextMuted}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
    </Style>
    <!-- Aide et valeur : vides (texte rempli plus tard par le code), elles ne laissent pas de trou dans la page -->
    <Style x:Key="Help" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.TextMuted}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================================================================ Boutons -->
    <!-- Gabarit commun : icône facultative (infra:AdminUi.Glyph, à la taille du texte) puis le texte -->
    <ControlTemplate x:Key="AdminButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                CornerRadius="{Binding Path=(infra:AdminUi.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <TextBlock x:Name="Icon" FontFamily="{DynamicResource IconFont}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"
                           Margin="0,0,8,0" Text="{Binding Path=(infra:AdminUi.Glyph), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="Presenter" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="infra:AdminUi.Glyph" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Margin" Value="0" />
                <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Bouton ordinaire -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template" Value="{StaticResource AdminButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.ControlPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Action principale : vert LibreBooth -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Admin.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.AccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Admin.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.AccentPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Admin.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Quitter, supprimer -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Admin.OnDanger}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.Danger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.DangerHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Admin.DangerHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.DangerPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Admin.DangerPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton discret (lien, « Voir », « Ouvrir le dossier ») -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Admin.AccentText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- « Quitter LibreBooth » : discret, en rouge -->
    <Style x:Key="DangerSubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Error}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.ErrorBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.ErrorBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Admin.Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Pastille du bas de l'admin (Appareil · Imprimante · Papier) -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="infra:AdminUi.CornerRadius" Value="16" />
    </Style>

    <!-- ================================================================ Cases à cocher et interrupteurs -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1.5"
                                Background="{DynamicResource Admin.Control}" BorderBrush="{DynamicResource Admin.ControlBorder}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13" Visibility="Collapsed"
                                       Foreground="{DynamicResource Admin.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter x:Name="Presenter" Grid.Column="1" Margin="10,0,0,0" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Admin.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Admin.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Admin.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Admin.Accent}" />
                            <Setter TargetName="Check" Property="Text" Value="&#xE738;" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interrupteur marche/arrêt (dans une SettingRow, qui lui donne son nom) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" Text="Désactivé" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Admin.TextMuted}" />
                        <Grid Width="44" Height="22" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border x:Name="Track" CornerRadius="11" BorderThickness="1.5" Background="Transparent"
                                    BorderBrush="{DynamicResource Admin.ControlBorder}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="5,0,0,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Admin.TextMuted}" />
                        </Grid>
                        <ContentPresenter x:Name="Presenter" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Admin.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="Text" Value="Activé" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Admin.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Admin.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Admin.OnAccent}" />
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Admin.AccentHover}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Admin.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Boutons radio et cartes à choix -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Margin" Value="0,4,24,4" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Ellipse x:Name="Ring" StrokeThickness="1.5" Fill="{DynamicResource Admin.Control}" Stroke="{DynamicResource Admin.ControlBorder}" />
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Admin.AccentText}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Presenter" Grid.Column="1" Margin="10,0,0,0" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Admin.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Admin.AccentText}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grande carte à choix unique : icône, titre (Content) et explication (infra:AdminUi.Description) -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" FontFamily="{DynamicResource IconFont}" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Admin.TextMuted}"
                                           Text="{Binding Path=(infra:AdminUi.Glyph), RelativeSource={RelativeSource TemplatedParent}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter RecognizesAccessKey="True" TextElement.FontWeight="SemiBold" />
                                    <TextBlock x:Name="Description" Style="{StaticResource Help}" Margin="0,2,0,0"
                                               Text="{Binding Path=(infra:AdminUi.Description), RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                                <Border x:Name="Mark" Grid.Column="2" Width="22" Height="22" CornerRadius="11" Margin="12,0,0,0" VerticalAlignment="Top"
                                        Background="{DynamicResource Admin.Accent}" Visibility="Hidden">
                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource Admin.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="Ring" BorderThickness="2" CornerRadius="10" BorderBrush="{DynamicResource Admin.AccentText}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.AccentSoft}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Admin.AccentText}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="infra:AdminUi.Glyph" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="infra:AdminUi.Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Champs de texte -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Admin.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,2,0,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                        <Border x:Name="FocusLine" Height="2" Margin="1,0" CornerRadius="0,0,6,6" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Background="{DynamicResource Admin.AccentText}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.AccentText}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource Admin.Window}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Admin.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,2,0,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <Border x:Name="FocusLine" Height="2" Margin="1,0" CornerRadius="0,0,6,6" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Background="{DynamicResource Admin.AccentText}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.AccentText}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Listes déroulantes -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
            <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="{DynamicResource IconFont}" FontSize="12" Margin="0,0,12,0"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Admin.TextMuted}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.ControlHover}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.AccentText}" />
                <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Zone de saisie d'une liste modifiable (IsEditable) -->
    <Style x:Key="ComboEditableText" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Admin.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6,34,6" />
        <Setter Property="Margin" Value="0,2,0,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <ToggleButton x:Name="Toggle" Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboEditableText}" Visibility="Hidden" Margin="10,4,34,4"
                                 VerticalAlignment="Center" IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDown" Margin="0,0,10,10" Padding="4" CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True"
                                    Background="{DynamicResource Admin.Card}" BorderBrush="{DynamicResource Admin.CardBorder}"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" />
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Admin.AccentText}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Sélecteur de date -->
    <!-- Le calendrier reste clair dans les deux apparences (jours bien lisibles) ; ses boutons gardent leur style d'origine. -->
    <Style x:Key="AdminCalendar" TargetType="Calendar">
        <Setter Property="Foreground" Value="#FF333333" />
        <Setter Property="Background" Value="White" />
        <Style.Resources>
            <Style TargetType="Button" />
        </Style.Resources>
    </Style>

    <Style x:Key="DatePickerButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="Afficher le calendrier" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,0" Margin="2">
                        <TextBlock Text="&#xE787;" FontFamily="{DynamicResource IconFont}" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Admin.TextMuted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.ControlHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AdminDatePickerTextBox" TargetType="prim:DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Admin.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="prim:DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Margin" Value="0,2,0,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="CalendarStyle" Value="{StaticResource AdminCalendar}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <prim:DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource AdminDatePickerTextBox}" Padding="{TemplateBinding Padding}" />
                                <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource DatePickerButton}" />
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusLine" Height="2" Margin="1,0" CornerRadius="0,0,6,6" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Background="{DynamicResource Admin.AccentText}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.AccentText}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Barres de défilement fines -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource Admin.ScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" Padding="2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Listes -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Admin.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu de gauche : une page par élément (icône infra:AdminUi.Glyph, puis le nom) -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Hidden"
                                Background="{DynamicResource Admin.AccentText}" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Icon" FontFamily="{DynamicResource IconFont}" FontSize="18" Width="20" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding Path=(infra:AdminUi.Glyph), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="Label" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.SidebarHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.SidebarSelected}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Admin.AccentText}" />
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="infra:AdminUi.Compact" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Menu réduit aux icônes : le nom de la page s'affiche au survol -->
            <Trigger Property="infra:AdminUi.Compact" Value="True">
                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Margin" Value="6,2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Sections repliables -->
    <Style x:Key="ExpanderHeader" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="20,14">
                        <DockPanel>
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Admin.TextMuted}" />
                            <TextBlock x:Name="Icon" FontFamily="{DynamicResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.FontSize="18" TextElement.FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Admin.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,4,20,20" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Style="{StaticResource ExpanderHeader}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Tag="{Binding Path=(infra:AdminUi.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ExpandSite" Margin="{TemplateBinding Padding}" Visibility="Collapsed" Focusable="False" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Cartes et bandeaux -->
    <!-- Les groupes de réglages deviennent des cartes : titre en haut, contenu dessous -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,16,20,18" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ContentPresenter x:Name="Header" DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="True" Margin="0,0,0,12"
                                              TextElement.FontSize="18" TextElement.FontWeight="SemiBold" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Admin.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Background" Value="{DynamicResource Admin.Divider}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Bandeaux d'information (fond léger, texte normal ; l'icône prend la couleur de l'état) -->
    <Style x:Key="InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Admin.InfoBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SuccessBar" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="{DynamicResource Admin.SuccessBackground}" />
    </Style>
    <Style x:Key="WarningBar" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="{DynamicResource Admin.WarningBackground}" />
    </Style>
    <Style x:Key="ErrorBar" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="{DynamicResource Admin.ErrorBackground}" />
    </Style>

    <!-- ================================================================ Curseurs -->
    <Style x:Key="SliderTrack" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="{DynamicResource Admin.Card}" Stroke="{DynamicResource Admin.ControlBorder}" StrokeThickness="1" />
                        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Admin.AccentText}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="12" />
                            <Setter TargetName="Dot" Property="Height" Value="12" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="8" />
                            <Setter TargetName="Dot" Property="Height" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdminFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrack}" Background="{DynamicResource Admin.Accent}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrack}" Background="{DynamicResource Admin.ScrollThumb}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Barre de progression -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Divider}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        <!-- Attente sans durée connue : un trait qui court (coordonnées sur 100, étirées à la largeur) -->
                        <Viewbox x:Name="Busy" Stretch="Fill" Visibility="Collapsed">
                            <Canvas Width="100" Height="1" ClipToBounds="True">
                                <Rectangle x:Name="Runner" Width="35" Height="1" Canvas.Left="-35" Fill="{TemplateBinding Foreground}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunBusy">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(Canvas.Left)"
                                                         From="-35" To="100" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RunBusy" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Info-bulles -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Background" Value="{DynamicResource Admin.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Admin.CardBorder}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" MaxWidth="420" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Ligne de réglage (infra:SettingRow) -->
    <Style TargetType="infra:SettingRow">
        <Setter Property="Foreground" Value="{DynamicResource Admin.Text}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="infra:SettingRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="Icon" Grid.RowSpan="2" Text="{TemplateBinding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="20"
                                   Margin="0,1,14,0" VerticalAlignment="Top" Foreground="{DynamicResource Admin.TextMuted}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ContentPresenter x:Name="Presenter" Grid.Column="2"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Stacked" Value="True">
                            <Setter TargetName="Presenter" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Presenter" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Presenter" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Presenter" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="Presenter" Property="Margin" Value="0,8,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
