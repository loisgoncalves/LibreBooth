<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:LibreBooth.App.Infrastructure">

    <!--
        Couleurs des écrans. Ce sont des valeurs de départ : Theme.Apply les remplace par celles de l'événement
        (thème d'impression ou fond PNG). Les écrans les utilisent toutes en DynamicResource.
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#14161C" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8BCC8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC83D" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#14161C" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFC83D" />
    <!-- Panneaux et cartes, boutons secondaires, bordures : voile blanc sur fond sombre, voile noir sur fond clair -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="KeyBrush" Color="#2C303A" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#F014161C" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A7A" />
    <!-- Messages pour l'animateur (papier, imprimante) : toujours lisibles, quel que soit le thème -->
    <SolidColorBrush x:Key="OperatorTextBrush" Color="#FFC83D" />

    <FontFamily x:Key="KioskFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Police des grands titres : celle du titre des impressions de l'événement -->
    <FontFamily x:Key="KioskTitleFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontWeight x:Key="KioskTitleWeight">Bold</FontWeight>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <infra:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <infra:EmptyToVisibleConverter x:Key="EmptyToVisible" />

    <!-- Grand titre : il prend la couleur du texte de l'écran (héritée) et la police du thème -->
    <Style x:Key="KioskTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="96" />
        <Setter Property="FontFamily" Value="{DynamicResource KioskTitleFont}" />
        <Setter Property="FontWeight" Value="{DynamicResource KioskTitleWeight}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="KioskSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Bouton sans apparence (zone tactile plein écran) -->
    <Style x:Key="InvisibleButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Sinon le style Windows des boutons imposerait un texte noir, illisible sur un thème sombre -->
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonBase" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource KioskFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="56,22" />
        <Setter Property="MinHeight" Value="112" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="56"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="112" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>

    <Style x:Key="KeyButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource KioskFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource KeyBrush}" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Height" Value="78" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DomainButton" TargetType="Button" BasedOn="{StaticResource KeyButton}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" CornerRadius="32" Padding="28" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Indicateur d'attente : un arc qui tourne -->
    <Style x:Key="Spinner" TargetType="Control">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Ellipse Stroke="{DynamicResource SurfaceBorderBrush}" StrokeThickness="12" />
                        <Ellipse x:Name="Arc"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="12"
                                 StrokeDashArray="7 100"
                                 StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Arc"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
