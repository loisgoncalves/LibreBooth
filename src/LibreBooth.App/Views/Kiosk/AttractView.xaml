<UserControl x:Class="LibreBooth.App.Views.Kiosk.AttractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Sur une image de fond : textes blancs avec une ombre ; sinon, couleurs du thème de l'événement -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        <Style x:Key="AttractTitle" TargetType="TextBlock" BasedOn="{StaticResource KioskTitle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBackground}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource TextShadow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AttractInvitation" TargetType="TextBlock" BasedOn="{StaticResource KioskSubtitle}">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBackground}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Effect" Value="{StaticResource TextShadow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Image Source="{Binding Background}" Stretch="UniformToFill" />
        <Rectangle IsHitTestVisible="False" Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Tout l'écran est un bouton « Commencer » (au doigt ou à la souris) -->
        <Button Style="{StaticResource InvisibleButton}" Command="{Binding StartCommand}">
            <Grid Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBackground}" Value="True">
                                    <Setter Property="TextElement.Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="230" Height="230" CornerRadius="115"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.07" Duration="0:0:0.9" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.07" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="&#xE722;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="112"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource AttractTitle}" Margin="0,64,0,0" MaxWidth="1600" />
                    <TextBlock Text="{Binding StartText}" Style="{StaticResource AttractInvitation}" Margin="0,24,0,0" MaxWidth="1500" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- Appareil pas encore prêt -->
        <Border Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Control Style="{StaticResource Spinner}" />
                <TextBlock Text="Le photobooth se prépare…" FontSize="64" FontWeight="SemiBold" Margin="0,48,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding NotReadyMessage}" FontSize="32" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="1400" Margin="0,24,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Information discrète pour l'animateur (papier bas, imprimante en erreur) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36" Padding="22,12" CornerRadius="16" Background="#CC000000"
                Visibility="{Binding OperatorWarning, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding OperatorWarning}" FontSize="24" Foreground="{DynamicResource OperatorTextBrush}" />
        </Border>
    </Grid>
</UserControl>
