<UserControl x:Class="LibreBooth.App.Views.Kiosk.ChooseTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="80,60,80,50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choisissez votre format" Style="{StaticResource KioskTitle}" FontSize="80" />

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,30">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="24"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Width="460">
                                <Border Height="560" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="18">
                                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="36" FontWeight="SemiBold" Margin="0,24,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" FontSize="26" Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Content="Retour" Command="{Binding BackCommand}" HorizontalAlignment="Center" />
    </Grid>
</UserControl>
