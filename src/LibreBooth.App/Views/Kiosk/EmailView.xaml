<UserControl x:Class="LibreBooth.App.Views.Kiosk.EmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LibreBooth.App.Controls">
    <Grid Margin="80,36,80,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Recevoir ma photo par e-mail" Style="{StaticResource KioskTitle}" FontSize="58" HorizontalAlignment="Center" />

        <Border Grid.Row="1" Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="20" Padding="32,14" Margin="0,24,0,0" Width="1400"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3">
            <Grid>
                <TextBlock Text="votre.adresse@exemple.fr" FontSize="50" Foreground="{DynamicResource PlaceholderBrush}"
                           Visibility="{Binding Address, Converter={StaticResource EmptyToVisible}}" />
                <TextBlock Text="{Binding Address}" FontSize="50" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Button Grid.Row="2" Style="{StaticResource LinkButton}" Command="{Binding ApplySuggestionCommand}" Margin="0,6,0,0"
                Visibility="{Binding Suggestion, Converter={StaticResource NullToCollapsed}}">
            <TextBlock>
                <Run Text="Vouliez-vous dire " /><Run Text="{Binding Suggestion, Mode=OneWay}" FontWeight="Bold" /><Run Text=" ?" />
            </TextBlock>
        </Button>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Domains}" HorizontalAlignment="Center" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DomainButton}" Content="{Binding}"
                            Command="{Binding DataContext.KeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:TouchKeyboard Grid.Row="4" KeyCommand="{Binding KeyCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
            <CheckBox IsChecked="{Binding ConsentChecked}" VerticalAlignment="Center" Margin="0,0,18,0" Focusable="False"
                      Visibility="{Binding RequireConsent, Converter={StaticResource BoolToVisibility}}">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="2.2" ScaleY="2.2" />
                </CheckBox.LayoutTransform>
            </CheckBox>
            <TextBlock Text="{Binding ConsentText}" FontSize="24" Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" MaxWidth="1400" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Retour" Command="{Binding BackCommand}" MinWidth="320" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Margin="40,0,0,0" MinWidth="420">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" Margin="0,0,22,0" VerticalAlignment="Center" />
                    <TextBlock Text="Envoyer" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
