<UserControl x:Class="LibreBooth.App.Views.Kiosk.PaperQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Par-dessus tout l'écran : le reste ne se touche plus tant que la question est affichée -->
    <Grid Background="#B0000000">
        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="2"
                CornerRadius="36" Padding="80,64" MaxWidth="1240" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="80" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <StackPanel TextElement.Foreground="{DynamicResource ForegroundBrush}">
                <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFont}" FontSize="96" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,28" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource KioskTitle}" FontSize="72" />
                <TextBlock Text="{Binding Message}" FontSize="36" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,24,0,0"
                           Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />

                <Control Style="{StaticResource Spinner}" Margin="0,48,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,56,0,0"
                            Visibility="{Binding ShowAnswers, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding YesCommand}" MinWidth="340" Margin="0,0,40,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Margin="0,0,24,0" VerticalAlignment="Center" />
                            <TextBlock Text="Oui" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding NoCommand}" MinWidth="340">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Margin="0,0,24,0" VerticalAlignment="Center" />
                            <TextBlock Text="Non" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Style="{StaticResource PrimaryButton}" Content="OK" Command="{Binding OkCommand}" MinWidth="340"
                        HorizontalAlignment="Center" Margin="0,56,0,0"
                        Visibility="{Binding ShowOk, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
