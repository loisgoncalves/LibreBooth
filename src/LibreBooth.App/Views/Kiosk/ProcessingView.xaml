<UserControl x:Class="LibreBooth.App.Views.Kiosk.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Control Style="{StaticResource Spinner}" Width="160" Height="160" />
            <TextBlock Text="{Binding Message}" FontSize="64" FontWeight="SemiBold" Margin="0,56,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="Encore une seconde, c'est presque prêt !" FontSize="34" Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,18,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
