<UserControl x:Class="LibreBooth.App.Views.Kiosk.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="60">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="640" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="28" Padding="34">
            <Image Source="{Binding CompositeImage}" Stretch="Uniform">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.45" />
                </Image.Effect>
            </Image>
        </Border>

        <!-- La colonne se réduit si tous les boutons et messages sont affichés en même temps -->
        <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" Margin="60,0,0,0">
            <StackPanel Width="580">
                <TextBlock Text="Superbe !" Style="{StaticResource KioskTitle}" FontSize="88" />
                <TextBlock Text="Que voulez-vous faire ?" FontSize="34" Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,44" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22"
                            Visibility="{Binding ShowCopiesSelector, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource RoundButton}" Content="–" Command="{Binding DecreaseCopiesCommand}" />
                    <StackPanel Width="230" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Copies}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CopiesLabel}" FontSize="22" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CopiesDetail}" FontSize="22" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                                   Visibility="{Binding CopiesDetail, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <Button Style="{StaticResource RoundButton}" Content="+" Command="{Binding IncreaseCopiesCommand}" />
                </StackPanel>

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}"
                        Visibility="{Binding ShowPrintButton, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFont}" Margin="0,0,24,0" VerticalAlignment="Center" />
                        <TextBlock Text="Imprimer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding PrintHint}" FontSize="24" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,12,0,0"
                           Visibility="{Binding PrintHint, Converter={StaticResource NullToCollapsed}}" />

                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RetakeCommand}" Margin="0,26,0,0"
                        Visibility="{Binding ShowRetakeButton, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,24,0" VerticalAlignment="Center" />
                        <TextBlock Text="Recommencer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}" Content="Terminer" Command="{Binding FinishCommand}" Margin="0,26,0,0" />

                <TextBlock Text="{Binding StatusMessage}" FontSize="30" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,40,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
